# Required for live voice, transcripts, simulated locals, and summaries
OPENAI_API_KEY=sk-...

# gpt-realtime is the first generally-available live voice model ("GPT live").
# Override with gpt-realtime-1.5, gpt-realtime-2, or gpt-realtime-2.1 if you prefer.
OPENAI_REALTIME_MODEL=gpt-realtime

# Optional: real outbound phone calls (Twilio Voice + a separate media-stream server)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# PUBLIC_MEDIA_STREAM_URL=wss://your-host/media-stream

# Optional: gate the whole site behind a shared passcode (see middleware.ts).
# Leave unset to disable the gate, e.g. for local development.
# SITE_PASSCODE=

# ---------------------------------------------------------------------------
# TEMPORARY - USER TESTING PHASE ONLY - REMOVE BEFORE GENERAL RELEASE
# Records finished call sessions (brief + transcript + summary) as research
# data, and shows testers a notice saying so. One flag drives both, so the
# notice can never be off while recording is on. See TESTING-ONLY.md.
# NEXT_PUBLIC_ENABLE_TEST_LOGGING=true
#
# Optional durable destination. Without it, sessions only reach the runtime
# logs, where they do not last. Point this at whatever collects the rows.
# TEST_LOG_WEBHOOK_URL=
# ---------------------------------------------------------------------------
